# CodePilot Backend — Environment Variables
# Copy this file to .env and fill in the values you need.
# .env is gitignored and should never be committed.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the Express server listens on (default: 3001)
PORT=3001

# ---------------------------------------------------------------------------
# AI Provider
# ---------------------------------------------------------------------------

# Which AI provider to use.
# Options:
#   mock     → No credentials needed. Uses repository-derived deterministic analysis.
#   groq     → Groq chat completions. Requires GROQ_API_KEY below.
#   watsonx  → IBM watsonx.ai. Requires the WATSONX_* variables below.
AI_PROVIDER=mock

# Groq (optional — https://console.groq.com/keys)
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# IBM watsonx.ai  (required when AI_PROVIDER=watsonx)
# ---------------------------------------------------------------------------

# IBM Cloud IAM API key — generate at https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=

# watsonx.ai project ID — find in your watsonx.ai project settings
WATSONX_PROJECT_ID=

# watsonx.ai service URL (default shown below; change region if needed)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model ID to use (default: ibm/granite-3-8b-instruct)
# Other options: ibm/granite-13b-instruct-v2, ibm/granite-20b-multilingual, meta-llama/llama-3-8b-instruct
WATSONX_MODEL=ibm/granite-3-8b-instruct

# ---------------------------------------------------------------------------
# GitHub  (optional — adds rate limit from 60 → 5,000 req/hr)
# ---------------------------------------------------------------------------

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: (none for public repos, "repo" for private repos)
GITHUB_TOKEN=
